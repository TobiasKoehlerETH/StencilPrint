{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StencilPrint",
  "version": "0.1.1",
  "identifier": "com.stencilprint.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "StencilPrint", "width": 1380, "height": 980, "minWidth": 1080, "minHeight": 780, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNEI3MDI4ODM1NjAzQUUKUldTdUExYURLSEJMb2p1WEl3bHlONzlZTWo2SWovRjZMVlFqcmZTb0RUZERqT1Q5VWc3RTRmc1AK",
      "endpoints": [
        "https://github.com/TobiasKoehlerETH/StencilPrint/releases/latest/download/latest.json"
      ]
    }
  }
}
